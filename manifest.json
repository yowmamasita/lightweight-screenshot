{
  "manifest_version": 3,
  "name": "GoFullPage Lite",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "Lightweight full-page and visible-area screenshot capture with zero extra permissions.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Screenshot (Full Page / What You See)",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+P",
        "mac": "Alt+Shift+P"
      },
      "description": "Open screenshot mode menu"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+V",
        "mac": "Alt+Shift+V"
      },
      "description": "Capture what you see (visible area)"
    }
  }
}
